<?php
/* ═════════════════════════════════════════════════════════════════════
 *  جوما — فایل نمونهٔ تنظیمات
 *  ───────────────────────────────────────────────────────────────────
 *  به‌طور عادی نیازی به دست‌زدن به این فایل ندارید:
 *  نصب‌کننده (install.php) فایل واقعی includes/config.php را خودش می‌سازد.
 *
 *  این نمونه فقط برای حالت اضطراری است؛ یعنی وقتی پوشهٔ includes قابل
 *  نوشتن نباشد. در آن حالت:
 *    ۱) از همین فایل یک کپی بگیرید و نام آن را config.php بگذارید.
 *    ۲) مقدارهای داخل گیومه را با اطلاعات هاست خودتان جایگزین کنید.
 *    ۳) فایل را در پوشهٔ includes/ آپلود کنید.
 *
 *  هشدار: هرگز فایل config.php واقعی خود را برای کسی نفرستید.
 * ═══════════════════════════════════════════════════════════════════ */

/* ── ۱) اتصال به دیتابیس (از بخش MySQL Databases در cPanel) ───────── */
define('DB_HOST', 'localhost');
define('DB_NAME', 'نام_دیتابیس_شما');
define('DB_USER', 'نام_کاربری_دیتابیس');
define('DB_PASS', 'رمز_دیتابیس');

/* ── ۲) نشانی سامانه (بدون اسلش پایانی) ──────────────────────────── */
define('APP_BASE_URL', 'https://example.com');

/* ── ۳) پیامک ────────────────────────────────────────────────────────
 *  SMS_ENABLED  : اگر false باشد هیچ پیامکی ارسال نمی‌شود و بازیابی
 *                 رمز عبور پرسنل کار نخواهد کرد.
 *  SMS_PROVIDER : 'smsir' = ارسال واقعی | 'dev' = فقط نوشتن در فایل لاگ
 *  نام پارامتر قالب در پنل SMS.ir باید دقیقاً CODE باشد.
 *  برای سرویس «کد تأیید» نیازی به شمارهٔ خط نیست؛ خالی بگذارید.      */
define('SMS_ENABLED', true);
define('SMS_PROVIDER', 'smsir');
define('SMSIR_API_KEY', '');
define('SMSIR_OTP_TEMPLATE_ID', '');
define('SMSIR_LINE', '');

/* ── ۴) کد تأیید یک‌بارمصرف ──────────────────────────────────────── */
define('OTP_CODE_LENGTH', 6);        /* طول کد: ۶ رقم                  */
define('OTP_TTL_SECONDS', 120);      /* اعتبار کد: ۱۲۰ ثانیه           */
define('OTP_MAX_ATTEMPTS', 5);       /* حداکثر ۵ بار وارد کردن کد      */
define('OTP_RESEND_COOLDOWN', 90);   /* فاصلهٔ ارسال دوباره: ۹۰ ثانیه  */

/* ── ۵) نشست کاربری ──────────────────────────────────────────────── */
define('SESSION_IDLE_TIMEOUT', 1800); /* خروج خودکار پس از ۳۰ دقیقه   */

/* ── ۶) منطقهٔ زمانی نمایش ────────────────────────────────────────── */
/*  همهٔ تاریخ‌ها در دیتابیس به وقت جهانی (UTC) ذخیره می‌شوند و فقط
 *  هنگام نمایش به این منطقهٔ زمانی و تقویم شمسی تبدیل می‌گردند.      */
define('APP_TIMEZONE', 'Asia/Tehran');
